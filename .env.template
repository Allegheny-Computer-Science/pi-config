# Chompers (llm-server) proxy configuration for the Pi coding agent.
# Copy this file to .env and fill in your values:
#   cp .env.template .env
#
# The Pi harness connects to the llm-server proxy deployed at llm.chompe.rs.
# The proxy forwards requests to the upstream Opencode Zen API and requires
# two auth gates:
#   1. A GitHub Enterprise session token (Authorization: Bearer ...)
#   2. The upstream Zen API key (X-Zen-Api-Key: ...)
# See: https://github.com/dluman/llm-server

# Base URL of the llm-server proxy (no trailing slash)
CHOMPERS_SERVER_URL=https://llm.chompe.rs/v1

# Your Zen API key for the upstream Opencode API
ZEN_API_KEY=your-zen-api-key

# Optional: a GitHub token that is a member of the configured GitHub Enterprise.
# If set, Pi exchanges it automatically for an llm-server session token.
# If omitted, you must run `/login chompers` inside Pi and authorize via the
# GitHub device-flow page in your browser.
GITHUB_TOKEN=ghp_...
